#!/usr/bin/env node
import { spawn } from "node:child_process";
import { randomUUID } from "node:crypto";
import { mkdtempSync, rmdirSync, statSync, unlinkSync } from "node:fs";
import { createConnection, createServer } from "node:net";
import { createInterface } from "node:readline";
import { stripVTControlCharacters } from "node:util";

const { MACTERM_SESSION: pane, MACTERM_SOCKET: control } = process.env;
const args = process.argv.slice(2);
const usage = "Usage: macterm-agy [--conversation ID]";
if (args.length === 1 && ["--help", "-h"].includes(args[0])) {
    console.log(usage);
    process.exit(0);
}
if (args.length && (args.length !== 2 || args[0] !== "--conversation" || !args[1])) {
    console.error(usage);
    process.exit(1);
}
if (!pane || !control || !process.stdin.isTTY) {
    console.error("Run macterm-agy in a local pane in a Macterm main window.");
    process.exit(1);
}

const directory = mkdtempSync("/tmp/macterm-agy-");
const path = `${directory}/bridge.sock`;
const agent = spawn("agy", ["acp", "--stdio"], { stdio: ["pipe", "pipe", "inherit"] });
const terminal = createInterface({ input: process.stdin, output: process.stdout, prompt: "agy> " });
const inflight = new Map();
const rows = new Map();
const sockets = new Set();
const permissions = new Map();
let nextID = 0;
let sessionID;
let turn;
let message;
let peer;
let registration;
let challenge;
let boundSocket;
let closed = false;

function clean(text) {
    return stripVTControlCharacters(String(text ?? "")).replace(/[\x00-\x08\x0b-\x1f\x7f-\x9f]/g, "");
}

function rpc(frame) {
    if (!closed && agent.stdin.writable) agent.stdin.write(JSON.stringify({ jsonrpc: "2.0", ...frame }) + "\n");
}

function request(method, params) {
    return new Promise((resolve, reject) => {
        const id = ++nextID;
        inflight.set(id, { resolve, reject });
        rpc({ id, method, params });
    });
}

function state() {
    return { busy: Boolean(turn), waiting: permissions.size > 0 };
}

function emit(frame) {
    if (peer?.writableLength > 32 * 1024 * 1024) peer.destroy();
    if (peer?.writable) peer.write(JSON.stringify(frame) + "\n");
}

function status() {
    emit({ type: "status", ...state() });
}

function upsert(row) {
    rows.set(row.id, row);
    emit({ type: "row", row });
}

function confirmPrompt() {
    if (!turn || turn.accepted) return;
    turn.accepted = true;
    upsert({ id: randomUUID(), kind: "user", text: clean(turn.text) });
    if (turn.owner && turn.owner === peer) emit({ type: "reply", id: turn.id, accepted: true, ...state() });
}

function update({ update }) {
    const { sessionUpdate: type, content } = update;
    if (type === "user_message_chunk" && turn) {
        confirmPrompt();
        return;
    }
    if (["agent_message_chunk", "agent_thought_chunk", "tool_call", "tool_call_update"].includes(type)) confirmPrompt();
    if (type === "agent_message_chunk" || type === "user_message_chunk") {
        const kind = type === "agent_message_chunk" ? "assistant" : "user";
        if (content?.type !== "text") return;
        if (message?.kind !== kind) message = { id: randomUUID(), kind, text: "" };
        const text = clean(content.text);
        if (kind === "assistant") process.stdout.write(text);
        message = { ...message, text: (message.text + text).slice(0, 64 * 1024) };
        upsert(message);
    } else if (type === "tool_call" || type === "tool_call_update") {
        message = undefined;
        const id = `tool:${update.toolCallId}`;
        const previous = rows.get(id);
        const details = content?.flatMap(item => {
            if (item.type === "content" && item.content?.type === "text") return [item.content.text];
            if (item.type === "diff") return [item.path, item.newText];
            return [];
        }).join("\n");
        const name = clean(update.title) || previous?.name || update.kind || "Tool";
        const status = update.status === "failed" ? "failed" : update.status === "completed" ? "completed"
            : update.status ? "running" : previous?.status ?? "running";
        const text = clean(details || previous?.text || JSON.stringify(update.rawInput ?? "")).slice(0, 64 * 1024);
        if (!previous) console.log(`\n${name}`);
        upsert({ id, kind: "tool", text, name, status });
    }
}

function showPermission() {
    const request = permissions.values().next().value;
    if (!request) return;
    const { params } = request;
    const title = clean(params.toolCall?.title) || "Tool";
    console.log(`\nPermission required for ${title}.`);
    if (params.toolCall?.rawInput !== undefined) console.log(clean(JSON.stringify(params.toolCall.rawInput, null, 2)));
    for (const [index, option] of params.options.entries()) console.log(`${index + 1}. ${clean(option.name)}`);
    console.log("0. Cancel");
    terminal.setPrompt("Select an option> ");
    terminal.prompt();
}

function cancelPermissions() {
    for (const id of permissions.keys()) rpc({ id, result: { outcome: { outcome: "cancelled" } } });
    permissions.clear();
    terminal.setPrompt("agy> ");
    status();
}

const agentOutput = createInterface({ input: agent.stdout, crlfDelay: Infinity });
agentOutput.on("line", line => {
    let frame;
    try { frame = JSON.parse(line); } catch { return; }
    const { id, method, params, result, error } = frame;
    if (method === "session/update" && (!sessionID || params.sessionId === sessionID)) {
        update(params);
    } else if (method === "session/request_permission" && params.sessionId === sessionID) {
        confirmPrompt();
        permissions.set(id, frame);
        if (permissions.size === 1) showPermission();
        status();
    } else if (method && id !== undefined) {
        rpc({ id, error: { code: -32601, message: "This client does not support the request." } });
    } else if (!method && inflight.has(id)) {
        const { resolve, reject } = inflight.get(id);
        inflight.delete(id);
        if (error) reject(new Error(error.message));
        else resolve(result);
    }
});

async function prompt(text, owner, id) {
    if (!sessionID || turn || permissions.size || typeof text !== "string" || !text.trim() || Buffer.byteLength(text) > 128 * 1024) {
        if (owner === peer && owner) emit({ type: "reply", id, accepted: false, ...state() });
        return;
    }
    turn = { id, owner, text, accepted: false };
    message = undefined;
    status();
    try {
        await request("session/prompt", { sessionId: sessionID, prompt: [{ type: "text", text }] });
        confirmPrompt();
    } catch (error) {
        upsert({ id: randomUUID(), kind: "assistant", text: clean(error.message) });
        if (!turn.accepted && owner && peer === owner) emit({ type: "reply", id, accepted: false, ...state() });
        console.error(`\n${clean(error.message)}`);
    } finally {
        turn = undefined;
        status();
        if (!closed && !permissions.size) {
            console.log();
            terminal.prompt();
        }
    }
}

function stop() {
    if (!turn && !permissions.size) return;
    rpc({ method: "session/cancel", params: { sessionId: sessionID } });
    cancelPermissions();
}

terminal.on("line", line => {
    if (permissions.size) {
        const request = permissions.values().next().value;
        const value = line.trim();
        const option = /^\d+$/.test(value) ? request.params.options[Number(value) - 1] : undefined;
        if (value !== "0" && !option) return showPermission();
        const outcome = option ? { outcome: "selected", optionId: option.optionId } : { outcome: "cancelled" };
        rpc({ id: request.id, result: { outcome } });
        permissions.delete(request.id);
        terminal.setPrompt("agy> ");
        status();
        showPermission();
    } else if (line === "/exit") {
        close();
    } else if (line.trim()) {
        if (turn) console.log("Wait for the current turn to end.");
        else void prompt(line);
    } else if (!turn) {
        terminal.prompt();
    }
});
terminal.on("SIGINT", () => turn || permissions.size ? stop() : close());
terminal.on("close", close);

const server = createServer(socket => {
    if (sockets.size >= 4) return socket.destroy();
    sockets.add(socket);
    socket.setTimeout(5000);
    socket.on("timeout", () => socket.destroy());
    socket.on("error", () => socket.destroy());
    socket.on("close", () => {
        sockets.delete(socket);
        if (peer === socket) peer = undefined;
    });
    const input = createInterface({ input: socket, crlfDelay: Infinity });
    input.on("line", line => {
        let command;
        try { command = JSON.parse(line); } catch { return socket.destroy(); }
        if (peer !== socket) {
            if (command?.type !== "hello" || !challenge || String(command.token).toLowerCase() !== challenge.token) {
                return socket.destroy();
            }
            boundSocket = challenge.identity;
            challenge = undefined;
            peer?.destroy();
            peer = socket;
            socket.setTimeout(0);
            emit({ type: "snapshot", conversation: sessionID });
            for (const row of rows.values()) emit({ type: "row", row });
            emit({ type: "snapshotEnd", ...state() });
        } else if (command?.type === "send" && typeof command.id === "string") {
            void prompt(command.text, socket, command.id);
        } else if (command?.type === "stop") {
            stop();
        }
    });
});

function register() {
    if (!sessionID || peer || registration || closed) return;
    let identity;
    try {
        const info = statSync(control);
        if (!info.isSocket()) return;
        identity = `${info.dev}:${info.ino}:${info.birthtimeMs}`;
    } catch { return; }
    if (identity === boundSocket) return;
    const token = randomUUID();
    challenge = { token, identity };
    const socket = createConnection(control);
    registration = socket;
    socket.setTimeout(3000);
    socket.once("connect", () => socket.end(JSON.stringify({
        v: 1, id: token, command: "agy.register",
        args: { session: pane, agentBridge: { conversation: sessionID, socket: path, token } },
    }) + "\n"));
    socket.on("timeout", () => socket.destroy());
    socket.on("error", () => socket.destroy());
    socket.on("close", () => { registration = undefined; });
    socket.resume();
}

const retry = setInterval(register, 2000).unref();
const startup = setTimeout(() => fail(new Error("Antigravity did not start in time.")), 30000).unref();

function close() {
    if (closed) return;
    closed = true;
    clearTimeout(startup);
    clearInterval(retry);
    registration?.destroy();
    for (const socket of sockets) socket.destroy();
    server.close();
    terminal.close();
    agentOutput.close();
    agent.stdin.destroy();
    agent.kill();
    for (const { reject } of inflight.values()) reject(new Error("The Antigravity connection closed."));
    inflight.clear();
    try { unlinkSync(path); } catch {}
    try { rmdirSync(directory); } catch {}
}

function fail(error) {
    if (closed) return;
    console.error(clean(error.message));
    process.exitCode = 1;
    close();
}

agent.on("error", fail);
agent.stdin.on("error", fail);
agent.on("exit", (code, signal) => {
    if (!closed) fail(new Error(`Antigravity closed (${code ?? signal}).`));
});
server.on("error", fail);
for (const signal of ["SIGHUP", "SIGINT", "SIGTERM"]) process.once(signal, close);

try {
    const initialized = await request("initialize", {
        protocolVersion: 1,
        clientCapabilities: {},
        clientInfo: { name: "Ghostty", version: process.env.TERM_PROGRAM_VERSION || "unknown" },
    });
    if (initialized.protocolVersion !== 1) throw new Error("Macterm requires ACP version 1.");
    const params = { cwd: process.cwd(), mcpServers: [] };
    if (args.length) {
        sessionID = args[1];
        await request("session/load", { ...params, sessionId: sessionID });
    } else {
        ({ sessionId: sessionID } = await request("session/new", params));
    }
    if (!sessionID) throw new Error("Antigravity did not provide a conversation ID.");
    clearTimeout(startup);
    message = undefined;
    console.log(`\nAntigravity conversation: ${clean(sessionID)}`);
    terminal.prompt();
    server.listen(path, register);
} catch (error) {
    fail(error);
}
